# Порт для запуска
PORT=3000

# Учетные данные администратора
# Задайте логин и bcrypt-хэш нового пароля администратора.
# По умолчанию старая пара ADM / 01121943 полностью заблокирована на сервере.
ADMIN_LOGIN=CHANGE_ME
ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# Секрет сервера для создания сессионных токенов
SERVER_SECRET=CHANGE_ME_RANDOM_LONG_STRING

# Секрет шифрования персональных данных (ФЗ-152)
# Это случайная строка/пароль, которая используется для шифрования данных абитуриентов в SQLite.
# Задайте сложную секретную строку.
ENCRYPTION_SECRET=CHANGE_ME_SECURE_KEY_STRING

# URL вашего приложения (например, https://my-site.ru) для настройки заголовков CORS
APP_URL=CHANGE_ME_HTTPS_URL
